<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F2FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- IMAGEN DEL EVENTO -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="8dp">

            <ImageView
                android:id="@+id/ivImagenEvento"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

        </androidx.cardview.widget.CardView>



        <!-- TARJETA PREMIUM -->
        <androidx.cardview.widget.CardView
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            android:padding="24dp"
            android:background="#FFFFFF">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">  <!-- ⭐ nuevo -->


                <!-- TÍTULO -->
                <TextView
                    android:id="@+id/tvEventoBoleto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre del Evento"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="6dp" />


                <!-- FECHA -->
                <TextView
                    android:id="@+id/tvFechaBoleto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fecha: "
                    android:textSize="16sp"
                    android:textColor="#444"
                    android:layout_marginBottom="6dp" />

                <!-- MÉTODO DE PAGO -->
                <TextView
                    android:id="@+id/tvPagoBoleto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pago con: "
                    android:textSize="15sp"
                    android:textColor="#555"
                    android:layout_marginBottom="16dp" />

                <!-- QR -->
                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="10dp"
                    android:layout_gravity="center"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/ivQRBoleto"
                        android:layout_width="250dp"
                        android:layout_height="250dp"
                        android:layout_margin="8dp" />
                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- BOTÓN DESCARGAR PDF -->
        <Button
            android:id="@+id/btnDescargarPDF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Descargar boleto en PDF"
            android:backgroundTint="#8A2BE2"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:padding="14dp"/>

    </LinearLayout>
</ScrollView>
